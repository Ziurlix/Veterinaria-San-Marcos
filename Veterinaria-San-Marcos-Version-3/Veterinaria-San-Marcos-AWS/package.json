    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@babel/core": "7.24.7",
    "@babel/preset-env": "7.24.7",
    "@babel/preset-react": "7.24.7",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.0.0",
    "babel-loader": "9.1.3",
    "babel-plugin-istanbul": "7.0.0",
    "jasmine-core": "5.1.2",
    "karma": "6.4.3",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
