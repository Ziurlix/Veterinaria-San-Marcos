{
  "name": "veterinaria-san-marcos",
  "version": "2.1.0",
  "private": true,
  "description": "Prototipo frontend de Veterinaria San Marcos con pruebas unitarias Karma y Jasmine",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
